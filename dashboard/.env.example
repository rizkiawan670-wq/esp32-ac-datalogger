# ============================================================================
# KONFIGURASI SUPABASE FRONTEND
# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase Anda
# ============================================================================

# URL project Supabase Anda (Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anonim Publik Supabase (Settings > API > Project API keys > anon / public)
# PERHATIAN: JANGAN PERNAH menaruh service_role key di frontend!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Device ID default yang dipantau
VITE_DEFAULT_DEVICE_ID=esp32-ac-01

# Mode simulasi data sensor jika perangkat keras belum aktif (true / false)
VITE_ENABLE_SIMULATION_MODE=false

# Google Gemini API Key untuk AI Diagnosa Full Online (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
